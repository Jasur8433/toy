# Адреса и секреты хранятся только на сервере. Не добавляйте .env в Git.
PORT=3000
APP_ADMIN_TOKEN=replace-with-a-long-random-value
# Один или несколько терминалов Hikvision. Формат JSON-массива.
# На терминале включите ISAPI и создайте отдельного пользователя с минимальными правами.
HIKVISION_DEVICES=[{"id":"main-entrance","name":"Главный вход","host":"https://192.168.1.20","username":"campus_api","password":"replace-me","pollPath":"/ISAPI/AccessControl/AcsEvent?format=json"}]
HIKVISION_POLL_MS=15000
# HEMIS: используйте документированный API вашего экземпляра. Endpoint должен вернуть массив студентов
# либо объект { "students": [...] }; поля настраиваются в HEMIS_FIELD_MAP.
HEMIS_STUDENTS_URL=https://hemis.example.edu/api/students
HEMIS_TOKEN=replace-with-hemis-token
HEMIS_AUTH_HEADER=Authorization
HEMIS_AUTH_PREFIX=Bearer
HEMIS_FIELD_MAP={"id":"id","name":"full_name","group":"group","active":"active"}
HEMIS_SYNC_MS=3600000
